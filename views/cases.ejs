<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="container">
  <!-- v2.0 案例库：一个案例 = 一个业务问题；Alan 交付的与行业参考分开放，避免混淆 -->
  <section class="v2-sec" style="padding-bottom:40px">
    <span class="kicker">落地案例</span>
    <h1 class="v2-h1" style="font-size:clamp(32px,4vw,52px)"><%- ct('home.cases_title') %></h1>
    <p class="v2-lead">一个案例对应一个业务问题，背后可能是几个系统一起在干活。客户名按行业匿名，经同意才署名。</p>
    <div class="v2-chips" style="margin-top:32px">
      <button class="v2-chip on" type="button">Alan 交付（<%= cases.length %>）</button>
      <a class="v2-chip" href="/industry" style="display:inline-flex;align-items:center;text-decoration:none">行业参考案例</a>
    </div>
    <p class="v2-muted" style="font-size:13.5px;margin:0">「行业参考」收录的是公开报道的其他企业案例，不是我做的，单独放在行业案例库，注明来源。</p>
  </section>
  <hr class="hairline">

  <section class="v2-sec">
    <% if (!cases.length) { %>
    <p class="v2-muted">案例整理中。</p>
    <% } else { %>
    <div class="v2-chips" id="v2-scene"><button class="v2-chip on" data-scene="">全部</button><% [...new Set(cases.map(c => c.scene).filter(Boolean))].forEach(s => { %><button class="v2-chip" data-scene="<%= s %>"><%= s %></button><% }) %></div>
    <div class="v2-grid" id="v2-cases">
      <% cases.forEach(c => { %>
      <a class="v2-card" href="/cases/<%= c.slug || c.id %>" data-scene="<%= c.scene %>">
        <span class="tag-line"><%= c.scene || '案例' %><%= c.industry ? ' · ' + c.industry.split('/')[0].trim() : (c.org ? ' · ' + c.org : '') %></span>
        <h3><%= c.title %></h3>
        <% if (c.hook) { %><p><%= c.hook %></p><% } %>
        <span class="foot"><span class="v2-badge<%= c.in_use ? '' : ' plain' %>"><%= c.in_use ? '企业在用' : '进行中' %></span><% if (c.related.length) { %><span class="v2-muted"><%= c.related.length %> 个系统</span><% } %></span>
      </a>
      <% }) %>
    </div>
    <% } %>
  </section>

  <%- include('partials/footer') %>
</div>
<script>
(function () {
  var bar = document.getElementById('v2-scene'), grid = document.getElementById('v2-cases');
  if (!bar) return;
  bar.addEventListener('click', function (e) {
    if (!e.target.dataset || e.target.dataset.scene === undefined) return;
    var s = e.target.dataset.scene;
    [].forEach.call(bar.children, function (b) { b.classList.toggle('on', b === e.target); });
    [].forEach.call(grid.children, function (c) { c.style.display = !s || c.dataset.scene === s ? '' : 'none'; });
  });
})();
</script>
<%- include('partials/tail') %>
