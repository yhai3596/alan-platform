<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="container">

  <!-- 首屏：左文右图，不居中（DESIGN.md 第 6 节） -->
  <section class="v2-hero">
    <div>
      <p class="v2-eyebrow v2-reveal"><%- ct('home.hero_eyebrow') %></p>
      <h1 class="v2-h1 v2-reveal"><% ctRaw('home.hero_title').split(/\r?\n/).forEach((l, i) => { %><%- i ? '<br>' : '' %><span><%= l %></span><% }) %></h1>
      <p class="v2-lead v2-reveal"><%- ct('home.hero_body') %><% if (inUse) { %><%= inUse %> 个 AI 落地项目正在企业里用着。<% } %></p>
      <div class="v2-cta v2-reveal">
        <a class="btn btn-solid" href="#contact" data-track="cta_click" data-track-meta="hero_contact"><%- ct('home.cta_primary') %></a>
        <a class="btn btn-secondary" href="/cases" data-track="cta_click" data-track-meta="hero_cases"><%- ct('home.cta_secondary') %></a>
      </div>
    </div>
    <figure class="v2-figure v2-reveal">
      <img src="<%- ctImg('site.portrait') || '/assets/alan.png' %>" alt="<%= ctRaw('id.name') %> · <%= ctRaw('id.title') %>">
      <% if (cases[0] && cases[0].in_use) { %>
      <a class="v2-live" href="/cases/<%= cases[0].slug %>" style="color:inherit;text-decoration:none"><i></i>正在运行：<%= cases[0].title %><small><%- ct('home.live_caption') %></small></a>
      <% } %>
    </figure>
  </section>

  <hr class="hairline">
  <!-- 信任条：只写可核查的事实；案例数从库里算 -->
  <div class="v2-trust v2-reveal">
    <div><b><%- ct('home.trust1_value') %></b><%- ct('home.trust1_label') %></div>
    <% if (cases.length) { %><div><b><%= cases.length %> 个</b>落地案例，<%= inUse %> 个企业在用</div><% } %>
    <div><b><%- ct('home.trust3_value') %></b><%- ct('home.trust3_label') %></div>
    <div><b><%- ct('home.trust4_value') %></b><%- ct('home.trust4_label') %></div>
    <div><b><%- ct('home.trust5_value') %></b><%- ct('home.trust5_label') %></div>
  </div>
  <hr class="hairline">

  <!-- 落地案例：按场景筛选，bento 7 张（3×3 填满） -->
  <% if (cases.length) { %>
  <section class="v2-sec" id="cases">
    <div class="v2-head"><div><span class="kicker">落地案例</span><h2><%- ct('home.cases_title') %></h2></div><p class="v2-muted"><%- ct('home.cases_body') %></p></div>
    <div class="v2-chips" id="v2-scene"><button class="v2-chip on" data-scene="">全部</button><% [...new Set(cases.map(c => c.scene).filter(Boolean))].forEach(s => { %><button class="v2-chip" data-scene="<%= s %>"><%= s %></button><% }) %></div>
    <div class="v2-grid" id="v2-cases">
      <% cases.forEach((c, i) => { %>
      <a class="v2-card v2-reveal" href="/cases/<%= c.slug || c.id %>" data-scene="<%= c.scene %>" data-i="<%= i %>">
        <span class="tag-line"><%= c.scene || '案例' %><%= c.industry ? ' · ' + c.industry.split('/')[0].trim() : '' %></span>
        <h3><%= c.title %></h3>
        <p><%= c.hook || '原来的问题与损失：待补' %></p>
        <span class="foot"><span class="v2-badge<%= c.in_use ? '' : ' plain' %>"><%= c.in_use ? '企业在用' : '进行中' %></span><% if (c.related.length) { %><span class="v2-muted"><%= c.related.length %> 个系统</span><% } %></span>
      </a>
      <% }) %>
    </div>
    <div class="v2-cta"><a class="btn btn-secondary" href="/cases">全部 <%= cases.length %> 个案例 →</a></div>
  </section>
  <hr class="hairline">
  <% } %>

  <!-- 在线可试：只放公开可访问的工具（工具集里 status=live 且有链接的） -->
  <% if (tools.length) { %>
  <section class="v2-sec" id="try">
    <div class="v2-head"><div><span class="kicker">在线可试</span><h2><%- ct('home.tools_title') %></h2></div><p class="v2-muted"><%- ct('home.tools_body') %></p></div>
    <div class="v2-grid">
      <% tools.forEach(t => { %>
      <a class="v2-card v2-reveal" href="<%= t.url %>" target="_blank" rel="noopener" data-track="tool_click" data-track-meta="<%= t.name %>">
        <span class="tag-line">№ <%= String(t.no).padStart(2, '0') %> · 在线可试 ↗</span>
        <h3><%= t.name %></h3><p><%= t.description %></p>
      </a>
      <% }) %>
      <a class="v2-card v2-reveal" href="/tools"><span class="tag-line">更多</span><h3>全部工具 →</h3><p>涉及企业数据的系统不对外开放，在案例页里用图文说明。</p></a>
    </div>
  </section>
  <hr class="hairline">
  <% } %>

  <%- include('partials/home-sections') %>

  <!-- 联系：公众号二维码 + 邮箱留资（沿用原订阅接口） -->
  <section class="v2-sec" id="contact">
    <div class="v2-split">
      <div>
        <span class="kicker">联系</span>
        <h2 style="font-weight:400;font-size:clamp(26px,3vw,40px);margin:0"><%- ct('home.contact_title') %></h2>
        <p class="v2-lead"><%- ct('home.contact_body') %></p>
        <form id="home-subscribe" style="display:flex;gap:12px;align-items:stretch;max-width:480px;margin-top:24px">
          <input class="input" type="email" id="home-subscribe-email" placeholder="you@example.com" aria-label="邮箱" style="flex:1">
          <button type="submit" class="btn btn-primary">联系我</button>
        </form>
        <p class="form-ok" id="home-subscribe-msg" style="margin-top:9px"></p>
      </div>
      <img class="v2-qr" src="<%- ctImg('site.qr_mp') %>" alt="公众号「Alan 的 AI 世界」二维码">
    </div>
  </section>

  <%- include('partials/footer') %>
</div>

<script>
(function () {
  // 场景筛选：「全部」只显示前 7 张（bento 3×3 填满，首张与第 7 张横跨两列）；选了场景显示该场景全部
  var grid = document.getElementById('v2-cases');
  function show(scene) {
    if (!grid) return;
    var cards = [].slice.call(grid.children), shown = 0;
    cards.forEach(function (c) {
      var ok = !scene || c.dataset.scene === scene;
      var vis = ok && (scene || shown < 7);
      c.style.display = vis ? '' : 'none';
      c.classList.remove('wide');
      if (vis) { shown++; if (!scene && cards.length >= 7 && (shown === 1 || shown === 7)) c.classList.add('wide'); }
    });
  }
  show('');
  var bar = document.getElementById('v2-scene');
  if (bar) bar.addEventListener('click', function (e) {
    if (!e.target.dataset || e.target.dataset.scene === undefined) return;
    [].forEach.call(bar.children, function (b) { b.classList.toggle('on', b === e.target); });
    show(e.target.dataset.scene);
  });
  // 进入动效：一次性，不回放（只动 transform/opacity）
  var io = 'IntersectionObserver' in window ? new IntersectionObserver(function (es) {
    es.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } });
  }, { rootMargin: '0px 0px -40px 0px' }) : null;
  [].forEach.call(document.querySelectorAll('.v2-reveal'), function (el) { io ? io.observe(el) : el.classList.add('in'); });
})();
document.getElementById('home-subscribe').addEventListener('submit', function (e) {
  e.preventDefault();
  var email = document.getElementById('home-subscribe-email').value.trim();
  var msg = document.getElementById('home-subscribe-msg');
  fetch('/api/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: email }) })
    .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
    .then(function (res) {
      msg.className = res.ok ? 'form-ok' : 'form-error';
      msg.textContent = res.ok ? '已收到，我会回复到这个邮箱。' : (res.d.error || '提交失败');
    })
    .catch(function () { msg.className = 'form-error'; msg.textContent = '网络异常，请稍后再试'; });
});
</script>
<%- include('partials/tail') %>
