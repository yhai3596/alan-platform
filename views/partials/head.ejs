<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<% const canon = (typeof canonical !== 'undefined' && canonical) ? canonical : seo.SITE_URL + '/'; %>
<% const metaDesc = (typeof description !== 'undefined' && description) ? description : ctRaw('id.oneliner'); %>
<meta name="description" content="<%= metaDesc %>">
<meta name="author" content="<%= ctRaw('id.name') %> · <%= ctRaw('id.title') %>">
<% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex"><% } else { %><link rel="canonical" href="<%= canon %>"><% } %>
<meta property="og:site_name" content="<%= seo.brand() %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= metaDesc %>">
<meta property="og:type" content="<%= (typeof articleLd !== 'undefined' && articleLd) ? 'article' : 'website' %>">
<meta property="og:url" content="<%= canon %>">
<meta property="og:locale" content="zh_CN">
<% for (const m of seo.verifyMetas()) { %><meta name="<%= m.name %>" content="<%= m.content %>">
<% } %>
<script type="application/ld+json"><%- seo.jsonLd(seo.siteGraph()) %></script>
<% if (typeof articleLd !== 'undefined' && articleLd) { %><script type="application/ld+json"><%- seo.jsonLd(articleLd) %></script><% } %>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23f3f2f2'/%3E%3Ctext x='16' y='23' font-family='Georgia,serif' font-size='22' text-anchor='middle' fill='%23201f1d'%3EA%3C/text%3E%3Ccircle cx='25' cy='22' r='2.6' fill='%23b68235'/%3E%3C/svg%3E">
<link rel="stylesheet" href="/vendor/cormorant-garamond/400.css">
<link rel="stylesheet" href="/vendor/cormorant-garamond/600.css">
<link rel="stylesheet" href="/vendor/lora/400.css">
<link rel="stylesheet" href="/vendor/lora/600.css">
<link rel="stylesheet" href="/vendor/noto-serif-sc/400.css">
<link rel="stylesheet" href="/vendor/noto-serif-sc/600.css">
<link rel="stylesheet" href="/css/ds.css?v=<%= assetVer %>">
<link rel="stylesheet" href="/css/site.css?v=<%= assetVer %>">
<script src="/js/theme.js?v=<%= assetVer %>"></script>
</head>
<body>
